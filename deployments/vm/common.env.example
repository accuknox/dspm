# Shared by every scanner instance on this VM.
# docker --env-file syntax: KEY=VALUE, no quotes around values, comments on their own line.
# Instance-specific settings (OBJECT_TYPE, targets, credentials, LABEL_ID) live in instances/<name>.env.
# Every variable is documented in the repository README and .env.example.

# ---- CSPM upload: <CSPM_URL>/api/v1/artifact/ -------------------------------------------------
CSPM_URL=https://cspm.example.com
ARTIFACT_TOKEN=
# LABEL_ID is set per instance (region + instance name), not here

# ---- AWS (used by S3 instances only) -------------------------------------------------------------
# One [profile] per member account lives in /etc/dspm/aws-config, mounted read-only into the container
AWS_CONFIG_FILE=/etc/dspm/aws-config

# ---- Classification --------------------------------------------------------------------------------
ENABLED_REGIONS=US,IN
MIN_CONFIDENCE=likely
DISABLED_DETECTORS=PII.IPAddress,MAC_ADDRESS,Healthcare Data Detection
REPORT_TOKEN_LIKE_VALUES=false
REPORT_PRIVATE_IPS=false
SAMPLE_LIMIT=10000
SAMPLE_STRATEGY=random
ADAPTIVE_SAMPLING=false

# ---- Names in free text (the memory driver) ---------------------------------------------------------
# en_core_web_trf: best accuracy, ~2.7 GB resident per scan process. en_core_web_sm: ~0.5 GB, lower recall.
NER_ENABLED=true
NER_MODEL=en_core_web_trf
