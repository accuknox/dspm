# One database instance = one host (every database on it). Two hosts = two instance files.
# Same file shape for MYSQL, MARIADB and MSSQL: change OBJECT_TYPE and DB_PORT.
OBJECT_TYPE=POSTGRES
# JSON list of database names on this host, or a single database with OBJECT_NAME=<db>
OBJECTS_TO_SCAN=["appdb", "analytics"]
DB_HOST=appdb.cluster-ro.us-east-1.rds.amazonaws.com
DB_PORT=5432
# a read-only account is enough
DB_USERNAME=dspm_reader
DB_PASSWORD=
# Alternative to host/port/user/password, with TLS options on the DSN
# (a CA bundle goes in /etc/dspm/keys/ and is referenced by that path):
# DB_URI=postgresql+psycopg2://dspm_reader:***@appdb.internal:5432/appdb?sslmode=verify-full&sslrootcert=/etc/dspm/keys/rds-ca.pem
LABEL_ID=us-east-1-postgres-appdb
