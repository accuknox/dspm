# One database instance = one Azure Database for PostgreSQL Flexible Server (every database on it).
# Same file shape for MySQL Flexible Server: OBJECT_TYPE=AZURE_MYSQL and DB_PORT=3306 (PyMySQL negotiates the TLS
# the server requires; for *.mysql.database.azure.com hosts the scanner also verifies the server certificate).
OBJECT_TYPE=AZURE_POSTGRES
OBJECTS_TO_SCAN=["appdb", "billing"]
DB_HOST=appdb.postgres.database.azure.com
DB_PORT=5432
# Option A: a read-only login (GRANT pg_read_all_data TO dspm_reader)
DB_USERNAME=dspm_reader
DB_PASSWORD=
# Option B: no password. The VM identity's Entra principal on the server is the user, created by the server's
# Entra administrator: SELECT * FROM pgaadauth_create_principal('dspm-scanner-vm', false, false);
#                      GRANT pg_read_all_data TO "dspm-scanner-vm";
# DB_USERNAME=dspm-scanner-vm
# DB_AUTH=azure_entra
# Pinning the CA (Flexible Server chains to DigiCert Global Root G2, in the image's system bundle) takes a DSN:
# DB_URI=postgresql+psycopg2://dspm_reader:***@appdb.postgres.database.azure.com:5432/appdb?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
LABEL_ID=eastus-postgres-appdb
