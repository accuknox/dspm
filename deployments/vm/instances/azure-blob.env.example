# One Azure Blob instance = one storage account (every container on it that holds data). ADLS Gen2 accounts
# work the same way through the Blob API. Credential: the VM's managed identity with the role Storage Blob
# Data Reader on the account (deployments/vm/azure/grant-access.sh); nothing else is needed here.
OBJECT_TYPE=AZURE_BLOB
AZURE_STORAGE_ACCOUNT=paymentsprod
# JSON list of container names, or a single container with OBJECT_NAME=<container>. A name may also be
# account/container or a container URL when the identity reads several accounts.
OBJECTS_TO_SCAN=["uploads", "exports"]
# Subscription that owns the account; recorded in every finding and required by the CSPM
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
# Sovereign clouds: core.usgovcloudapi.net | core.chinacloudapi.cn (default core.windows.net)
# AZURE_STORAGE_ENDPOINT_SUFFIX=
# Without a managed identity: a service principal (AZURE_TENANT_ID + AZURE_CLIENT_ID + AZURE_CLIENT_SECRET),
# or one of AZURE_STORAGE_SAS_TOKEN (read + list) / AZURE_STORAGE_CONNECTION_STRING / AZURE_STORAGE_ACCOUNT_KEY
# Region + instance, so the CSPM can tell instances apart
LABEL_ID=eastus-blob-paymentsprod
