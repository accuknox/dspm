# One DynamoDB instance = one AWS account (all of its tables in this region), exactly like an S3 instance.
OBJECT_TYPE=DYNAMODB

# JSON list of table names, or a single table with OBJECT_NAME=<table>
OBJECTS_TO_SCAN=["customers", "orders"]

# Region of the tables; the DynamoDB client is regional
OBJECT_REGION=us-east-1

# Profile from /etc/dspm/aws-config (the member role needs dynamodb:Scan, see aws/member-role-policy.json).
# For static keys instead: omit AWS_PROFILE, set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
AWS_PROFILE=account-a

# Owner of the tables; recorded in every finding and required by the CSPM
AWS_ACCOUNT_ID=111122223333

# Region + instance, so the CSPM can tell instances apart
LABEL_ID=us-east-1-dynamodb-account-a

# Each table is read with one Scan of up to SAMPLE_LIMIT items (common.env), which counts against its read capacity.
