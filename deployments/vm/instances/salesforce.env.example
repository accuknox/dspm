# One Salesforce instance = one org. Connected App with the client-credentials flow (docs/salesforce.md).
OBJECT_TYPE=SALESFORCE
# My Domain name (acme for acme.my.salesforce.com) or the full instance URL
OBJECT_NAME=acme
SF_CONSUMER_KEY=
SF_CONSUMER_SECRET=
# SF_OBJECTS=Contact,Lead,Case     # optional: pin the sObjects; default is every business object holding records
# SF_INCLUDE_FILES=true            # also scan files attached to records
LABEL_ID=us-east-1-salesforce
