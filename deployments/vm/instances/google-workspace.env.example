# One Google Workspace instance = one tenant. Service account + domain-wide delegation with the
# read-only Drive scope (docs/google-workspace.md). The key JSON goes in /etc/dspm/keys/.
OBJECT_TYPE=GOOGLE_WORKSPACE
# What to scan: a user email (that user's My Drive) or a shared-drive id; a JSON list scans several
OBJECTS_TO_SCAN=["alice@example.com", "bob@example.com"]
GOOGLE_SA_KEY_FILE=/etc/dspm/keys/gws-scanner.json
# GOOGLE_IMPERSONATE_USER / GOOGLE_DRIVE_ID pin one target explicitly and override the list
LABEL_ID=us-east-1-google-workspace
