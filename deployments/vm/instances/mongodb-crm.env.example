# One MongoDB / DocumentDB instance = one cluster (every database on it).
OBJECT_TYPE=MONGODB
# JSON list of database names, or a single database with OBJECT_NAME=<db>
OBJECTS_TO_SCAN=["crm"]
DB_HOST=mongo.internal
DB_PORT=27017
DB_USERNAME=dspm_reader
DB_PASSWORD=
# DocumentDB requires TLS with the Amazon CA bundle: put global-bundle.pem in /etc/dspm/keys/ and use a URI
# instead of the four lines above:
# DB_URI=mongodb://dspm_reader:***@docdb.cluster-xyz.us-east-1.docdb.amazonaws.com:27017/?tls=true&tlsCAFile=/etc/dspm/keys/global-bundle.pem
LABEL_ID=us-east-1-mongodb-crm
