# One S3 instance = one AWS account (all of its buckets in this region).
OBJECT_TYPE=S3
# JSON list of bucket names, or a single bucket with OBJECT_NAME=<bucket>
OBJECTS_TO_SCAN=["customer-uploads", "billing-exports"]
OBJECT_REGION=us-east-1
# Profile from /etc/dspm/aws-config. For static keys instead: omit AWS_PROFILE, set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
AWS_PROFILE=account-a
# Owner of the buckets; recorded in every finding and required by the CSPM
AWS_ACCOUNT_ID=111122223333
# Region + instance, so the CSPM can tell instances apart
LABEL_ID=us-east-1-s3-account-a
