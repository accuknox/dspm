# One database instance = one Azure SQL logical server (every database on it, one contained user each).
# Azure SQL Managed Instance is the same file with its private endpoint host.
OBJECT_TYPE=AZURE_SQL
OBJECTS_TO_SCAN=["appdb"]
DB_HOST=appdb-server.database.windows.net
DB_PORT=1433
# A contained database user in db_datareader:
#   CREATE USER dspm_reader WITH PASSWORD = '...'; ALTER ROLE db_datareader ADD MEMBER dspm_reader;
DB_USERNAME=dspm_reader
DB_PASSWORD=
# Reached through pymssql (FreeTDS, encrypted). Entra ID / managed-identity logins need the Microsoft ODBC
# driver, which the image does not ship: use a SQL login.
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
LABEL_ID=eastus-azuresql-appdb
