# One Cosmos DB for NoSQL instance = one account (every database on it). Credential: the VM's managed identity
# with the data-plane role "Cosmos DB Built-in Data Reader" (deployments/vm/azure/grant-access.sh), or the
# account's read-only key.
OBJECT_TYPE=COSMOS_NOSQL
# Account URL, or just the account name
AZURE_COSMOS_ENDPOINT=https://crm-cosmos.documents.azure.com:443/
# JSON list of database names, or a single database with OBJECT_NAME=<db>
OBJECTS_TO_SCAN=["crm"]
# Only without the data-plane role: the read-only key from the account's Keys blade
# AZURE_COSMOS_KEY=
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
LABEL_ID=eastus-cosmos-crm
