# One Cosmos DB for MongoDB instance = one account (every database on it). Use the read-only connection string
# from the account's Connection strings blade (RU accounts) or a read-only database user (vCore clusters).
OBJECT_TYPE=COSMOS_MONGO
OBJECTS_TO_SCAN=["crm"]
DB_URI=
# RU-based account (port 10255, key in the URI):
# DB_URI=mongodb://crm-mongo:***@crm-mongo.mongo.cosmos.azure.com:10255/?ssl=true&replicaSet=globaldb&retrywrites=false&maxIdleTimeMS=120000&appName=@crm-mongo@
# vCore cluster (SRV record; dnspython ships in the image):
# DB_URI=mongodb+srv://dspm_reader:***@crm-cluster.global.mongocluster.cosmos.azure.com/?tls=true&authMechanism=SCRAM-SHA-256&retrywrites=false&maxIdleTimeMS=120000
# Request-rate throttling (RU accounts, error 16500) is retried from the last document read; lower SAMPLE_LIMIT
# in common.env if it happens on every run.
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
LABEL_ID=eastus-cosmos-mongo-crm
