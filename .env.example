# DSPM scanner configuration - copy to .env (settings.py loads it; real environment variables win).
# Values below are the recommended production settings for best accuracy; "#" lines explain the trade-offs.
# Never commit .env. Everything here is read by settings.py; the master (Lambda) mode takes the same
# keys in its "config" payload (README "Master mode").

# ============================================================ Targets
# One or many targets: JSON object {"name": "type", ...} - types: s3, postgres, mysql, mariadb, mssql,
# mongodb, google_workspace (Drive), salesforce
OBJECTS_TO_SCAN={"customer-uploads": "s3", "appdb": "postgres"}
# Single-target alternative (ignored when OBJECTS_TO_SCAN is set)
OBJECT_TYPE=
OBJECT_NAME=
# AWS region for the S3 client (applies to every S3 target)
OBJECT_REGION=us-east-1

# ============================================================ AWS / S3
AWS_ACCOUNT_ID=
# Leave empty to use the instance profile / IRSA; set only for static keys
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ============================================================ Databases (PostgreSQL / MySQL / MariaDB / MSSQL / MongoDB)
# Either a full URI ...
DB_URI=                                   # e.g. postgresql+psycopg2://scanner:***@db.internal:5432/appdb?sslmode=require   # pragma: allowlist secret
# ... or the parts (a read-only account is enough)
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=

# ============================================================ SaaS (Google Workspace Drive / Salesforce)
# Google Workspace: service account + domain-wide delegation with the read-only scope
# https://www.googleapis.com/auth/drive.readonly (README "Google Workspace (Drive)")
GOOGLE_SA_KEY_FILE=                       # service-account key JSON path (GOOGLE_APPLICATION_CREDENTIALS also works)
GOOGLE_IMPERSONATE_USER=                  # user@example.com - scan that user's My Drive (needs domain-wide delegation)
GOOGLE_DRIVE_ID=                          # ...or one shared-drive id instead
# Salesforce: Connected App, OAuth client-credentials flow; the run-as integration user needs a
# permission set with "API Enabled", "View All Data" and "Query All Files" (README "Salesforce")
SF_DOMAIN=                                # My Domain name (acme) or the full https:// instance URL
SF_CONSUMER_KEY=
SF_CONSUMER_SECRET=
SF_OBJECTS=                               # pin sObjects (Contact,Lead,...); empty = every queryable business object holding records
SF_INCLUDE_FILES=true                     # scan the files attached to records (ContentVersion / Attachment bodies)
SF_API_VERSION=                           # default v62.0

# ============================================================ CSPM upload
# Findings are uploaded to <CSPM_URL>/api/v1/artifact/ as a zip; leave CSPM_URL empty to keep them local only
CSPM_URL=
ARTIFACT_TOKEN=
LABEL_ID=test
# Findings / work directory (the container image sets /app/output; mount a volume there)
OUTPUT_DIR=

# ============================================================ Classification - reporting
# Lowest confidence tier reported: possible | likely | very_likely.
#   likely      recommended. One strong signal or a classified column (Nightfall's recommended minimum).
#   very_likely strict mode: only corroborated findings and classified columns (what the old 0.9 threshold meant).
#   possible    calibration only - every candidate, never for a CSPM feed.
MIN_CONFIDENCE=likely

# Regional identifier packs, comma-separated ISO codes. Enable only where the customer operates: every pack
# adds weak shapes (with GB on, a US phone number is a valid NHS number one time in ten).
# Available (62 packs): AE AR AT AU BE BG BR CA CH CL CN CZ DE DK EE EG ES FI FR GB GH GR HK HR HU ID IE IL IN IS IT JP KR LK LT LU LV MX MY NG NL NO NZ PH PK PL PT RO RS RU SA SE SG SI SK TH TR TW UA US VN ZA  (UK is an alias for GB)
ENABLED_REGIONS=US,IN

# Random-looking strings with no keyword / credential-field evidence (Secret.TokenLikeValue).
# false recommended: no vendor reports generic high-entropy strings; specific formats, password=... assignments
# and credential-named columns are still detected. true only for a dedicated secrets hunt.
REPORT_TOKEN_LIKE_VALUES=false

# RFC 1918 / loopback / link-local addresses as PII.IPAddress - infrastructure data, keep off
REPORT_PRIVATE_IPS=false

# Detectors never reported (names from fixtures/findings-mapping.json), comma-separated or a JSON list.
# Public IPs and MACs are high-volume low-value in almost every store; "Healthcare Data Detection" is a coarse
# keyword-count heuristic (the labelled PHI identifiers NPI / MBI / claim / Rx numbers stay on).
DISABLED_DETECTORS=PII.IPAddress,MAC_ADDRESS,Healthcare Data Detection

# Macie-style allow lists: exact values (comma-separated or JSON list) and a JSON list of regexes over values
# that are never findings - the customer's own public support address / phone number, known sample data.
ALLOW_LIST=
ALLOW_REGEX=

# ============================================================ Classification - column and count rules
# Leave empty to use the per-detector policies (src/engine/policy.py); set to override every detector.
# COLUMN_RATIO: share of a column's sampled non-empty values that must match to classify the column (Sentra: 0.5)
COLUMN_RATIO=
# MIN_COUNT: distinct `possible` hits in one file / mixed column that become `likely` (policy default 10;
# lower to 5 for document-heavy buckets where recall on bare card / SSN lists matters more than noise)
MIN_COUNT=
# Hits on one (detector, column) that collapse into a single column-level finding with an occurrence count; 0 disables
AGGREGATION_THRESHOLD=25

# ============================================================ Sampling
# Rows / documents read per table or collection. Column verdicts settle long before 10000; raise it only to
# find rare needles in free-text columns.
SAMPLE_LIMIT=10000
# head: the first SAMPLE_LIMIT rows (oldest rows on most tables).
# random: TABLESAMPLE on PostgreSQL / MSSQL tables larger than twice the limit, $sample on MongoDB, head on MySQL.
# Recommended: random for recurring scans of large stores, head for the first baseline scan you review by hand.
SAMPLE_STRATEGY=random
# Stop reading a table / collection once its column verdicts are stable (min 2000 rows, 1000-row stability window).
# false for the first baseline scan (read the full sample you review), true for recurring scans.
ADAPTIVE_SAMPLING=false

# ============================================================ Names in free text
# Person names inside prose (notes, PDFs, comments) through spaCy. requirements.txt ships both models:
#   en_core_web_trf  RoBERTa transformer, best accuracy (OntoNotes NER F1 0.90), ~450 MB + CPU torch, ~50-100 ms per prose cell
#   en_core_web_sm   statistical, F1 0.84, 12 MB, ~2 ms per cell - the fallback when the transformer cannot load
# NER_MODEL picks one explicitly; empty = transformer when installed, else sm.
NER_ENABLED=true
NER_MODEL=en_core_web_trf
